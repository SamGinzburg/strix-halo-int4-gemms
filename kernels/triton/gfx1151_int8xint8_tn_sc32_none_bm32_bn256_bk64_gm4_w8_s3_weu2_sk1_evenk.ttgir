    %13 = arith.truncf %acc : tensor<32x256xf32, #mma> to tensor<32x256xbf16, #mma> loc(#loc44)
    %14 = ttg.convert_layout %13 : tensor<32x256xbf16, #mma> -> tensor<32x256xbf16, #linear> loc(#loc44)
    amdg.buffer_store %14, %c[%12] {contiguity = 8 : i32} : tensor<32x256xbf16, #linear> loc(#loc44)
    tt.return loc(#loc)
  } loc(#loc)
} loc(#loc)
