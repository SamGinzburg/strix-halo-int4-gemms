    %13 = ttg.convert_layout %acc_82 : tensor<16x128xf32, #mma> -> tensor<16x128xf32, #blocked1> loc(#loc41)
    %14 = amdg.buffer_atomic_rmw fadd, relaxed, gpu, %13, %c[%12] : tensor<16x128xf32, #blocked1> loc(#loc41)
    tt.return loc(#loc)
  } loc(#loc)
} loc(#loc)
